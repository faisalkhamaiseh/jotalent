# Copy to .env and fill in. Never commit .env.

# ---- App ----
# Working name, shown in the UI and page titles. Change it here only.
NEXT_PUBLIC_APP_NAME="JoTalent"
# Public origin of the site, no trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Database (PostgreSQL) ----
# Default matches `npm run db:dev` (Prisma's local Postgres, no Docker needed).
# With `docker compose up -d` instead use:
#   postgresql://jotalent:jotalent@localhost:5432/jotalent
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Connections the app may open. The embedded dev database runs a single
# backend and drops extra connections under load, so it needs 1. Remove this
# line (or raise it) when DATABASE_URL points at a real PostgreSQL server.
DATABASE_POOL_MAX="1"
# Scratch database Prisma uses to diff migrations (`npm run db:migrate`).
# Required with `npm run db:dev`. With docker compose or a hosted Postgres,
# leave it empty and Prisma creates a temporary one itself.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ---- Auth ----
# Signs sessions and tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# How many of your own reverse proxies sit between visitors and the app
# (1 for a single platform or load balancer, 2 for a CDN in front of one).
# It decides which X-Forwarded-For entry is trusted as the visitor's address
# for sign-in lockouts. Too low and everyone shares the proxy's address and
# gets locked out together; too high and visitors can fake their address.
TRUSTED_PROXY_HOPS=1

# Lets the built-in stand-ins (console email/SMS, mock payments) run in a
# production build. For staging and local `npm run build && npm start` only.
ALLOW_DEV_SERVICES="false"

# ---- Email: Resend (https://resend.com/api-keys) ----
# Empty = emails (verification codes, notifications) are printed to the server log.
RESEND_API_KEY=""
# Must be an address on a domain you verified in Resend.
EMAIL_FROM="JoTalent <onboarding@resend.dev>"

# ---- SMS: Twilio (https://console.twilio.com) ----
# Empty = phone codes are printed to the server log.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# A Twilio phone number or messaging-service sender, in E.164.
TWILIO_FROM=""

# ---- Payments ----
# "mock" simulates checkout inside the app (no money moves).
# "stripe" uses Stripe Checkout; then both keys below are required, and a
# webhook for `checkout.session.completed` must point at /api/webhooks/stripe.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- File storage ----
# Folder for private uploads (certificates, delivery files).
STORAGE_DIR="./storage"

# ---- Seed ----
# First admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@jotalent.test"
SEED_ADMIN_PASSWORD=""
# Password shared by the demo accounts from `npm run db:seed:demo` (dev only).
SEED_DEMO_PASSWORD=""
