{
  "name": "jotalent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "prisma dev --detach --name jotalent --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:stop": "prisma dev stop jotalent",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "db:passwords": "tsx prisma/sync-passwords.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tabs": "^1.1.22",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
